const cards = [
    { id: 1, title: 'Card 1' },
    { id: 2, title: 'Card 2' },
    { id: 3, title: 'Card 3' },
    { id: 4, title: 'Card 4' },
  ];
  
  const fromIndex = 1; // Card 2
  const toIndex = 3; 

  interface Card {
    id: number;
    title: string;
  }
  
  function reorderCards(cards: Card[], fromIndex: number, toIndex: number): Card[] {
    const updatedCards = [...cards];
    const [movedCard] = updatedCards.splice(fromIndex, 1);
    updatedCards.splice(toIndex, 0, movedCard);
    return updatedCards;
  }

import {CdkDragDrop, moveItemInArray} from '@angular/cdk/drag-drop';

cards = [...];

drop(event: CdkDragDrop<Card[]>){
    this.cards = [...this.cards];
    moveItemInArray(this.cards, event.previousIndex, event.currentIndex);   
}

//[cdkDragDisabled]="isReadOnly" cdkDragDisabled is used to disabled the drag and drop